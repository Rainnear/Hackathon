# Copy this file to .env.local and fill in the values from
# Supabase dashboard › Project Settings › API (or "Connect" at the top of the dashboard).
# .env.local is git-ignored. Never put the service_role / secret key here: everything in
# this file is bundled into the app and visible to anyone who opens it.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or, on older projects, the "anon public" key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Shown on the Help page so people can call, text or email the Sakto team.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
